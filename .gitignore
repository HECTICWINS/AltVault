dist/
__pycache__/
*.pyc
*.bak
*.tmp

# Never commit personal data. AltVault keeps it in %LOCALAPPDATA%\AltVault; these are listed in
# case a copy ever lands in this folder.
accounts.dat
settings.json
history.json
altvault.log
pyram.log
avatars/
game-icons/
altvault-*.ico
# Export files hold your logins (password-protected, but still never shared).
*.altvault

# Local dev helpers (prototypes, screenshot harnesses, old backups)
dev/

# Key-making: the private signing key and any saved key must never be committed.
*.blob
signing-key*
license.key
my-pc-key.txt
